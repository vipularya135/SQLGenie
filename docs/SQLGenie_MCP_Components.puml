@startuml SQLGenie_MCP_Components
title MCP Server - Core Components

package "mcp_server.py" {
    component "MCP Handler" as handler
    component "DatabaseManager" as db
    component "Security" as sec
}

package "Data" {
    file "sakila.db" as sakila
    folder "uploaded_databases/" as uploaded
    folder "schema_cache/" as cache
}

handler --> db : manages
db --> sec : validates
db --> sakila : queries
db --> uploaded : queries
db --> cache : caches

note right of sec : Read-only queries only\nMax 1000 rows\n30 second timeout

@enduml