@startuml SQLGenie_MCP_Sequence_Workflow
title MCP Sequence - Simple Flow

actor User
participant "Claude Desktop" as Claude
participant "MCP Server" as Server
participant "Database" as DB

User -> Claude : "Show me customers from California"
Claude -> Server : MCP tool call (execute_sql_query)
Server -> Server : Validate query (security)
Server -> DB : SELECT query
DB -> Server : Results
Server -> Claude : Data + insights
Claude -> User : "Found 45 customers..."

note right of Server : Security: Read-only only\nLimit: 1000 rows max\nTimeout: 30 seconds

@enduml